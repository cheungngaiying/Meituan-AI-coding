<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SkillLoop · 技能互换平台</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #faf6f1;
    --bg-deep: #f3ece4;
    --card: #fffdfb;
    --primary: #c97b5a;
    --primary-dark: #b0654a;
    --primary-soft: #f5e2d8;
    --primary-soft2: #faeae1;
    --accent: #8a9a7b;
    --accent-soft: #e9eee3;
    --gold: #c9a227;
    --gold-soft: #f8f0d6;
    --text: #3a342f;
    --text-2: #6b625a;
    --muted: #9c938a;
    --border: #ece2d8;
    --border-strong: #ddcec0;
    --radius: 18px;
    --shadow-sm: 0 1px 2px rgba(90,60,40,.04), 0 4px 14px rgba(90,60,40,.05);
    --shadow-md: 0 2px 6px rgba(90,60,40,.06), 0 12px 28px rgba(90,60,40,.09);
    --shadow-lift: 0 6px 16px rgba(90,60,40,.10), 0 20px 44px rgba(90,60,40,.12);
    --ring: 0 0 0 4px rgba(201,123,90,.16);
    --stroke: 1.5px;
  }

  html { font-size: 16px; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    background:
      radial-gradient(1100px 600px at 12% -8%, #fff6ee 0%, transparent 60%),
      radial-gradient(900px 500px at 105% 0%, #f7eee5 0%, transparent 55%),
      var(--bg);
    overflow-x: hidden;
  }

  /* ================= 泡泡背景（放大 5 倍） ================= */
  #bubbles {
    position: fixed; inset: 0; z-index: 0;
    pointer-events: none; overflow: hidden;
  }
  .bubble {
    position: absolute; bottom: -400px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.9), rgba(201,123,90,.14) 55%, rgba(201,123,90,.04) 80%);
    box-shadow: inset 0 0 60px rgba(255,255,255,.7), 0 0 60px rgba(201,123,90,.06);
    border: 2px solid rgba(255,255,255,.55);
    animation: floatUp linear infinite;
    opacity: .5;
  }
  .bubble.green {
    background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.9), rgba(138,154,123,.14) 55%, rgba(138,154,123,.04) 80%);
  }
  .bubble.gold {
    background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.9), rgba(201,162,39,.12) 55%, rgba(201,162,39,.04) 80%);
  }
  @keyframes floatUp {
    0%   { transform: translateY(0) translateX(0) scale(1); opacity: 0; }
    10%  { opacity: .55; }
    50%  { transform: translateY(-60vh) translateX(40px) scale(1.04); }
    90%  { opacity: .45; }
    100% { transform: translateY(-130vh) translateX(-30px) scale(1.08); opacity: 0; }
  }

  .shell {
    max-width: 1240px; margin: 0 auto;
    padding: 32px 28px 126px;
    position: relative; z-index: 1;
  }

  .page { display: none; animation: fadeUp .3s ease; }
  .page.active { display: block; }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ================= 统一横版式边框容器 ================= */
  .box {
    background: var(--card);
    border: var(--stroke) solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm), inset 0 1px 0 #fff;
  }
  .box-hover {
    transition: transform .2s cubic-bezier(.2,.8,.2,1), box-shadow .2s, border-color .2s;
    cursor: pointer;
    position: relative;
  }
  .box-hover:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
    border-color: var(--primary);
  }
  .box-hover:active { transform: translateY(-1px); }

  /* ================= 顶部状态条 ================= */
  .topbar {
    display: flex; justify-content: space-between; align-items: center;
    gap: 22px; flex-wrap: wrap;
    padding: 20px 26px; margin-bottom: 24px;
    background: linear-gradient(135deg, #fffdfb 0%, #fdf6f0 100%);
    position: relative; overflow: hidden;
  }
  .topbar::after {
    content: ""; position: absolute; right: -40px; top: -70px;
    width: 200px; height: 200px; border-radius: 50%;
    background: radial-gradient(circle, rgba(201,123,90,.08), transparent 70%);
    pointer-events: none;
  }
  .topbar .who {
    font-weight: 700; font-size: 1.12rem;
    display: flex; align-items: center; gap: 12px;
  }
  .topbar .who small {
    display: block; color: var(--text-2); font-weight: 500;
    font-size: .76rem; margin-top: 4px;
    background: var(--primary-soft2); padding: 2px 10px; border-radius: 20px;
    border: 1px solid #f2d9cb;
  }
  .avatar {
    width: 46px; height: 46px; border-radius: 13px;
    background: linear-gradient(135deg, var(--primary-soft) 0%, #f7e6dc 100%);
    color: var(--primary-dark);
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 1rem; flex-shrink: 0;
    border: var(--stroke) solid #fff;
    box-shadow: 0 2px 8px rgba(201,123,90,.16), inset 0 1px 0 #fff;
  }
  .stats { display: flex; gap: 12px; align-items: center; }
  .stat {
    text-align: center; min-width: 84px;
    padding: 9px 14px; border-radius: 13px;
    background: rgba(255,255,255,.75);
    border: var(--stroke) solid var(--border);
    box-shadow: inset 0 1px 0 #fff;
  }
  .stat b { display: block; font-size: 1.32rem; color: var(--primary-dark); font-weight: 800; letter-spacing: -.5px; }
  .stat span { font-size: .68rem; color: var(--muted); font-weight: 700; letter-spacing: .3px; }

  /* 通知铃 */
  .bell-wrap { position: relative; }
  .bell {
    width: 42px; height: 42px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.15rem; cursor: pointer;
    background: #fff; border: var(--stroke) solid var(--border-strong);
    transition: all .18s; box-shadow: var(--shadow-sm);
  }
  .bell:hover { border-color: var(--primary); transform: translateY(-2px) rotate(-8deg); }
  .bell .dot {
    position: absolute; top: 8px; right: 9px;
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--primary); border: 2px solid #fff;
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(201,123,90,.5); }
    50% { box-shadow: 0 0 0 6px rgba(201,123,90,0); }
  }

  /* ================= 区块标题（完整边框横条） ================= */
  h2.section {
    font-size: 1.02rem; font-weight: 800;
    margin: 30px 0 15px;
    display: flex; align-items: center; gap: 10px;
    padding: 10px 16px;
    background: linear-gradient(135deg, #fffdfb, #fdf6f0);
    border: var(--stroke) solid var(--border-strong);
    border-radius: 13px;
    box-shadow: var(--shadow-sm), inset 0 1px 0 #fff;
  }
  h2.section .ico-box {
    width: 30px; height: 30px; border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
    background: var(--primary-soft2); border: 1px solid #f2d9cb;
    font-size: .95rem; flex-shrink: 0;
  }
  h2.section .hint {
    font-size: .72rem; color: var(--muted); font-weight: 700;
    margin-left: auto; background: var(--bg-deep);
    padding: 4px 11px; border-radius: 20px;
    border: var(--stroke) solid var(--border);
  }
  h2.section:first-of-type { margin-top: 0; }

  /* ================= 卡片 ================= */
  .card { padding: 20px; margin-bottom: 16px; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  @media (max-width: 980px) { .grid { grid-template-columns: 1fr; } }

  /* ================= 英雄区 ================= */
  .hero {
    background: linear-gradient(140deg, #fffdfb 0%, #fdf3ec 55%, #f8ece2 100%);
    border: var(--stroke) solid var(--border-strong);
    border-radius: 22px;
    padding: 32px 32px;
    margin-bottom: 24px;
    position: relative; overflow: hidden;
    box-shadow: var(--shadow-md), inset 0 1px 0 #fff;
  }
  .hero::before {
    content: ""; position: absolute; right: -60px; top: -80px;
    width: 300px; height: 300px; border-radius: 50%;
    background: radial-gradient(circle, rgba(201,123,90,.12), transparent 68%);
  }
  .hero::after {
    content: ""; position: absolute; left: -40px; bottom: -100px;
    width: 240px; height: 240px; border-radius: 50%;
    background: radial-gradient(circle, rgba(138,154,123,.10), transparent 68%);
  }
  .hero > * { position: relative; z-index: 1; }
  .hero h1 {
    font-size: 1.7rem; font-weight: 800; letter-spacing: -.4px;
    line-height: 1.3; margin-bottom: 10px;
  }
  .hero h1 em {
    font-style: normal;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero p { font-size: .92rem; color: var(--text-2); max-width: 620px; margin-bottom: 20px; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-actions .btn { width: auto; padding: 12px 24px; }
  .hero-stats {
    display: flex; gap: 28px; margin-top: 24px; flex-wrap: wrap;
    padding-top: 20px; border-top: 1px dashed var(--border-strong);
  }
  .hero-stat b { display: block; font-size: 1.4rem; font-weight: 800; color: var(--primary-dark); letter-spacing: -.4px; }
  .hero-stat span { font-size: .76rem; color: var(--muted); font-weight: 600; }

  /* ================= 工具栏 ================= */
  .toolbar {
    display: flex; gap: 12px; flex-wrap: wrap; align-items: center;
    padding: 14px 16px; margin-bottom: 18px;
  }
  .search-box { flex: 1; min-width: 240px; position: relative; }
  .search-box input {
    width: 100%; padding: 11px 16px 11px 42px;
    font-size: .92rem; border-radius: 12px;
    border: var(--stroke) solid var(--border-strong);
    background: #fff; outline: none; transition: all .18s;
    font-family: inherit;
    box-shadow: inset 0 1px 2px rgba(90,60,40,.03);
  }
  .search-box input:focus { border-color: var(--primary); box-shadow: var(--ring); }
  .search-box .s-ico {
    position: absolute; left: 15px; top: 50%; transform: translateY(-50%);
    font-size: 1rem; color: var(--muted); pointer-events: none;
  }
  .filter-chips { display: flex; gap: 7px; flex-wrap: wrap; }
  .fchip {
    font-size: .8rem; font-weight: 700;
    padding: 8px 14px; border-radius: 20px;
    border: var(--stroke) solid var(--border-strong); background: #fff;
    color: var(--text-2); cursor: pointer; transition: all .18s;
    user-select: none;
  }
  .fchip:hover { border-color: var(--primary); color: var(--primary-dark); }
  .fchip.active {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff; border-color: var(--primary-dark);
    box-shadow: 0 4px 12px rgba(201,123,90,.3);
  }

  /* ================= 用户卡片 ================= */
  .user-row { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  .user-row .name {
    font-weight: 700; font-size: 1rem;
    display: flex; align-items: center; flex-wrap: wrap; gap: 6px;
  }
  .user-row .meta { font-size: .78rem; color: var(--muted); margin-top: 3px; }

  .badge {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: .68rem; font-weight: 700;
    padding: 2px 9px; border-radius: 20px; border: var(--stroke) solid transparent;
  }
  .badge.verified { background: var(--accent-soft); color: var(--accent); border-color: #d6e0cc; }
  .badge.credit   { background: var(--gold-soft); color: #9a7a12; border-color: #eee0b6; }
  .badge.hot      { background: #fde8e2; color: #c4553a; border-color: #f6cfc4; }
  .badge.rank     { background: var(--primary-soft2); color: var(--primary-dark); border-color: #f0d6c7; }

  .skill-pair { display: flex; flex-direction: column; gap: 8px; }
  .skill-line { display: flex; align-items: baseline; gap: 9px; font-size: .88rem; }
  .skill-line .label {
    font-size: .68rem; font-weight: 800;
    padding: 2px 9px; border-radius: 6px; flex-shrink: 0;
    border: var(--stroke) solid transparent;
  }
  .label.teach { background: var(--accent-soft); color: #5f7052; border-color: #d9e3cd; }
  .label.learn { background: var(--primary-soft2); color: var(--primary-dark); border-color: #f2d9cb; }
  .skill-line b { font-weight: 700; }
  .skill-line .sub { color: var(--muted); font-size: .75rem; font-weight: 500; }

  .tag {
    font-size: .82rem; font-weight: 600;
    padding: 6px 13px; border-radius: 20px;
    background: var(--bg-deep); color: var(--text);
    border: var(--stroke) solid var(--border-strong);
    box-shadow: inset 0 1px 0 #fff;
  }
  .tag.teach-tag { background: var(--accent-soft); color: #55654a; border-color: #d3dfc6; }
  .tag.learn-tag { background: var(--primary-soft2); color: var(--primary-dark); border-color: #f0d6c8; }
  .skill-tags { display: flex; flex-wrap: wrap; gap: 7px; }

  .match-flag {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: .75rem; font-weight: 700;
    color: var(--accent); background: var(--accent-soft);
    border: var(--stroke) solid #d6e0cc;
    padding: 6px 13px; border-radius: 20px; margin-top: 14px;
  }
  .match-flag.credit-flag { color: var(--primary-dark); background: var(--primary-soft2); border-color: #f2d9cb; }

  .empty {
    text-align: center; color: var(--muted); font-size: .9rem;
    padding: 40px 20px; font-weight: 500;
  }

  /* ================= 按钮 ================= */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; padding: 13px 22px;
    font-size: .95rem; font-weight: 700;
    font-family: inherit; cursor: pointer;
    border-radius: 12px;
    transition: all .2s cubic-bezier(.2,.8,.2,1);
    border: 2px solid transparent; position: relative; overflow: hidden;
  }
  .btn:focus-visible { outline: none; box-shadow: var(--ring); }
  .btn-primary {
    background: transparent; border: 2px solid var(--primary);
    color: var(--primary-dark); box-shadow: 0 2px 8px rgba(201,123,90,.10);
  }
  .btn-primary:hover {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff; box-shadow: 0 8px 22px rgba(201,123,90,.38), inset 0 1px 0 rgba(255,255,255,.25);
    transform: translateY(-2px);
  }
  .btn-primary:active { transform: translateY(0); }
  .btn-solid {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff; box-shadow: 0 6px 18px rgba(201,123,90,.32), inset 0 1px 0 rgba(255,255,255,.22);
  }
  .btn-solid:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(201,123,90,.42), inset 0 1px 0 rgba(255,255,255,.25);
    filter: brightness(1.05);
  }
  .btn-solid:active { transform: translateY(0); }
  .btn-ghost { background: #fff; border: 2px solid var(--border-strong); color: var(--text-2); }
  .btn-ghost:hover { border-color: var(--primary); color: var(--primary-dark); background: var(--primary-soft2); transform: translateY(-2px); }
  .btn-danger { background: transparent; border: 2px solid #d9c3bb; color: #a8857a; font-size: .88rem; padding: 11px 18px; }
  .btn-danger:hover { border-color: #c77b6a; color: #b04f3d; background: #fdf0ec; }
  .btn + .btn { margin-top: 10px; }
  .actions { display: flex; flex-direction: column; gap: 0; margin-top: 20px; }

  /* ================= 表单 ================= */
  .form-group { margin-bottom: 18px; }
  .form-group:last-child { margin-bottom: 0; }
  .form-group > label { display: block; font-size: .86rem; font-weight: 700; margin-bottom: 8px; }
  .form-group > label .req { color: var(--primary); margin-left: 2px; }
  input[type=text], select, textarea {
    width: 100%; padding: 12px 15px; font-size: .92rem;
    border: var(--stroke) solid var(--border-strong); border-radius: 11px;
    background: #fff; color: var(--text); font-family: inherit;
    outline: none; transition: all .18s;
    box-shadow: inset 0 1px 2px rgba(90,60,40,.03);
  }
  input[type=text]:hover, select:hover, textarea:hover { border-color: var(--primary-soft); }
  input[type=text]:focus, select:focus, textarea:focus { border-color: var(--primary); box-shadow: var(--ring); }
  textarea { resize: vertical; min-height: 92px; line-height: 1.6; }
  select {
    cursor: pointer; appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%23c97b5a' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat; background-position: right 15px center; padding-right: 40px;
  }
  .form-row { display: flex; gap: 13px; }
  .form-row > * { flex: 1; }

  .chip-select { display: flex; flex-wrap: wrap; gap: 9px; }
  .chip {
    font-size: .84rem; font-weight: 600;
    padding: 9px 17px; border-radius: 11px;
    border: var(--stroke) solid var(--border-strong); background: #fff;
    color: var(--text-2); cursor: pointer; user-select: none;
    transition: all .18s cubic-bezier(.2,.8,.2,1);
    box-shadow: inset 0 1px 0 #fff;
  }
  .chip:hover { border-color: var(--primary); color: var(--primary-dark); transform: translateY(-1px); }
  .chip.selected {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff; border-color: var(--primary-dark);
    box-shadow: 0 4px 12px rgba(201,123,90,.35), inset 0 1px 0 rgba(255,255,255,.25);
  }

  /* ================= 进度条 ================= */
  .progress-track { display: flex; align-items: center; gap: 0; margin: 6px 0 2px; }
  .p-step {
    flex: 1; display: flex; flex-direction: column; align-items: center;
    position: relative; font-size: .72rem; font-weight: 700; color: var(--muted);
  }
  .p-step .p-dot {
    width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: #fff; border: 2px solid var(--border-strong);
    font-size: .9rem; margin-bottom: 7px; z-index: 1;
    transition: all .25s;
  }
  .p-step.done .p-dot { background: var(--accent); border-color: var(--accent); color: #fff; }
  .p-step.current .p-dot {
    background: var(--primary); border-color: var(--primary); color: #fff;
    box-shadow: 0 0 0 5px rgba(201,123,90,.16);
    animation: pulseDot 1.8s infinite;
  }
  @keyframes pulseDot {
    0%,100% { box-shadow: 0 0 0 5px rgba(201,123,90,.16); }
    50% { box-shadow: 0 0 0 10px rgba(201,123,90,.05); }
  }
  .p-step.current { color: var(--primary-dark); }
  .p-step.done { color: var(--accent); }
  .p-step:not(:last-child)::after {
    content: ""; position: absolute; top: 16px; left: 50%; width: 100%; height: 2px;
    background: var(--border-strong); z-index: 0;
  }
  .p-step.done:not(:last-child)::after { background: var(--accent); }

  /* ================= 排行榜 ================= */
  .rank-item {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 16px; border-radius: 12px;
    transition: all .18s; border: var(--stroke) solid transparent;
    margin-bottom: 6px;
  }
  .rank-item:last-child { margin-bottom: 0; }
  .rank-item:hover { background: var(--primary-soft2); border-color: var(--border-strong); }
  .rank-item .r-no {
    width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: .82rem;
    background: var(--bg-deep); color: var(--text-2);
    border: var(--stroke) solid var(--border);
  }
  .rank-item .r-no.top1 { background: linear-gradient(135deg, #f7d774, #e0b53c); color: #6b4f00; border-color: #e0c060; }
  .rank-item .r-no.top2 { background: linear-gradient(135deg, #e2e2e2, #c0c0c0); color: #555; border-color: #c0c0c0; }
  .rank-item .r-no.top3 { background: linear-gradient(135deg, #e8c9a8, #cfa076); color: #5c3a1a; border-color: #d4b090; }
  .rank-item .r-body { flex: 1; min-width: 0; }
  .rank-item .r-name { font-weight: 700; font-size: .9rem; }
  .rank-item .r-skill { font-size: .76rem; color: var(--muted); margin-top: 2px; }
  .rank-item .r-score { font-weight: 800; color: var(--primary-dark); font-size: .92rem; }

  /* ================= 成就 ================= */
  .achieve-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  @media (max-width: 900px) { .achieve-grid { grid-template-columns: repeat(2, 1fr); } }
  .achieve {
    text-align: center; padding: 15px 8px; border-radius: 13px;
    background: #fff; border: var(--stroke) solid var(--border);
    transition: all .2s; cursor: default;
  }
  .achieve.unlocked { border-color: var(--gold); background: linear-gradient(160deg, #fffdf5, #fdf6e3); }
  .achieve:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .achieve .a-ico { font-size: 1.65rem; margin-bottom: 6px; filter: grayscale(1); opacity: .4; }
  .achieve.unlocked .a-ico { filter: none; opacity: 1; }
  .achieve .a-name { font-size: .78rem; font-weight: 700; color: var(--text-2); }
  .achieve.unlocked .a-name { color: var(--text); }

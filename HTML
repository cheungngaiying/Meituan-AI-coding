let state = loadState();

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
  } catch (e) {}
  return JSON.parse(JSON.stringify(DEFAULT_STATE));
}
function saveState() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
}

/* ================= 匹配逻辑 ================= */
function norm(s) { return (s || '').toLowerCase().replace(/[\s\-_·]/g, ''); }
function canTeach(a, b) {
  if (!a || !b) return false;
  if (a.cat !== b.cat) return false;
  const x = norm(a.name), y = norm(b.name);
  return x.includes(y) || y.includes(x);
}
function isBarter(me, other) {
  return canTeach(me.teach, other.learn) && canTeach(other.teach, me.learn);
}
function theyCanTeachMe(me, other) {
  return canTeach(other.teach, me.learn);
}

/* ================= 筛选 ================= */
let filterCat = '全部';
let searchText = '';

function initFilters() {
  document.querySelectorAll('#filter-chips .fchip').forEach(c => {
    c.onclick = () => {
      document.querySelectorAll('#filter-chips .fchip').forEach(x => x.classList.remove('active'));
      c.classList.add('active');
      filterCat = c.dataset.cat;
      renderDiscover();
    };
  });
  document.getElementById('search-input').addEventListener('input', e => {
    searchText = e.target.value.trim().toLowerCase();
    renderDiscover();
  });
}

function matchFilter(u) {
  if (filterCat !== '全部') {
    if (![u.teach.cat, u.learn.cat].includes(filterCat)) return false;
  }
  if (searchText) {
    const text = (u.name + u.teach.name + u.learn.name + u.teach.cat + u.learn.cat).toLowerCase();
    if (!text.includes(searchText)) return false;
  }
  return true;
}

/* ================= 渲染 ================= */
function renderTopbar() {
  document.getElementById('me-name').textContent = state.me.name;
  document.getElementById('me-avatar').textContent = state.me.avatar;
  document.getElementById('me-sub').textContent =
    `🎓 ${state.me.teach.name || '待填写'}  ↔  🌱 ${state.me.learn.name || '待填写'}`;
  document.getElementById('me-credit').textContent = state.me.credit;
  document.getElementById('me-points').textContent = state.me.points;
}

function skillLine(type, skill) {
  const isTeach = type === 'teach';
  return `<div class="skill-line">
    <span class="label ${isTeach ? 'teach' : 'learn'}">${isTeach ? '能教' : '想学'}</span>
    <span><b>${skill.name}</b>
      <span class="sub">· ${skill.cat} / ${skill.level}${skill.form ? ' / ' + skill.form : ''}</span>
    </span>
  </div>`;
}

function userCard(u, opts) {
  const flagCls = opts.mode === 'credit' ? 'match-flag credit-flag' : 'match-flag';
  return `<div class="card box box-hover" onclick="openDetail('${u.id}', '${opts.mode}')">
    <div class="user-row">
      <div class="avatar">${u.avatar}</div>
      <div>
        <div class="name">${u.name}
          ${u.hot ? '<span class="badge hot">🔥 热门</span>' : ''}
          <span class="badge credit">⭐ 信用 ${u.credit}</span>
        </div>
        <div class="meta">已完成 ${u.exchanges || 0} 次交换 · ${u.reviews.length} 条评价</div>
      </div>
    </div>
    <div class="skill-pair">
      ${skillLine('teach', u.teach)}
      ${skillLine('learn', u.learn)}
    </div>
    <div class="${flagCls}">${opts.flag}</div>
  </div>`;
}

function renderDiscover() {
  renderTopbar();
  const me = state.me;
  const barter = [], credit = [];

  state.users.forEach(u => {
    if (!matchFilter(u)) return;
    if (isBarter(me, u)) barter.push(u);
    else if (theyCanTeachMe(me, u)) credit.push(u);
  });

  const lb = document.getElementById('list-barter');
  lb.innerHTML = barter.length
    ? barter.map(u => userCard(u, { mode: 'barter', flag: '✨ 双向互惠 · 可直接技能互换' })).join('')
    : '<div class="card box empty">暂无互惠匹配，试试补充你的技能档案或调整筛选条件 🔍</div>';

  const lc = document.getElementById('list-credit');
  lc.innerHTML = credit.length
    ? credit.map(u => userCard(u, { mode: 'credit', flag: '🎟️ 可用 1 积分发起学习' })).join('')
    : '<div class="card box empty">暂无可学技能，换个分类或关键词试试</div>';

  renderRank();
}

function renderRank() {
  const sorted = [...state.users].sort((a, b) => (b.exchanges || 0) - (a.exchanges || 0)).slice(0, 6);
  document.getElementById('rank-list').innerHTML = sorted.map((u, i) => `
    <div class="rank-item">
      <div class="r-no ${i === 0 ? 'top1' : i === 1 ? 'top2' : i === 2 ? 'top3' : ''}">${i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : i + 1}</div>
      <div class="avatar" style="width:36px;height:36px;font-size:.9rem;border-radius:10px;">${u.avatar}</div>
      <div class="r-body">
        <div class="r-name">${u.name} <span class="badge credit">⭐ ${u.credit}</span></div>
        <div class="r-skill">🎓 ${u.teach.name} · 🌱 ${u.learn.name}</div>
      </div>
      <div class="r-score">${u.exchanges} 次</div>
    </div>
  `).join('');
}

function reviewHTML(r) {
  const stars = '★'.repeat(r.stars) + '☆'.repeat(5 - r.stars);
  return `<div class="review">
    <div class="r-head">
      <div class="r-user">
        <span class="mini-avatar">${r.by.slice(0, 1)}</span>
        ${r.by}
        <span class="stars">${stars}</span>
      </div>
      <span class="r-time">${r.time}</span>
    </div>
    <div class="r-body">${r.text}</div>
    ${r.tags && r.tags.length ? `<div class="r-meta">
      ${r.tags.map(t => `<span class="r-tag pos"># ${t}</span>`).join('')}
    </div>` : ''}
  </div>`;
}

function renderProfile() {
  const me = state.me;
  document.getElementById('pf-avatar').textContent = me.avatar;
  document.getElementById('pf-name').textContent = me.name;
  document.getElementById('pf-exchanges').textContent = me.exchanges;
  document.getElementById('pf-points').textContent = me.points;
  document.getElementById('pf-credit').textContent = me.credit;

  const rank = me.credit >= 85 ? '🏅 资深交换者'
            : me.credit >= 72 ? '🥈 活跃交换者'
            : '🥉 新星交换者';
  document.getElementById('pf-rank').textContent = rank;

  document.getElementById('pf-teach').innerHTML = me.teach.name
    ? `<span class="tag teach-tag">🎓 ${me.teach.cat} · ${me.teach.name}（${me.teach.level}）</span>`
    : '<span class="empty" style="padding:8px 0">尚未填写，去发布页添加</span>';

  document.getElementById('pf-learn').innerHTML = me.learn.name
    ? `<span class="tag learn-tag">🌱 ${me.learn.cat} · ${me.learn.name}（${me.learn.level}）</span>`
    : '<span class="empty" style="padding:8px 0">尚未填写，去发布页添加</span>';

  const achieves = [
    { ico: '🌱', name: '初次发布', desc: '发布技能档案', unlocked: true },
    { ico: '🎓', name: '初次教学', desc: '完成 1 次教学', unlocked: me.exchanges >= 1 },
    { ico: '🔄', name: '交换达人', desc: '完成 5 次交换', unlocked: me.exchanges >= 5 },
    { ico: '⭐', name: '好评如潮', desc: '信用分达 80', unlocked: me.credit >= 80 },
    { ico: '🔥', name: '热门教师', desc: '连续 3 周活跃', unlocked: false },
    { ico: '🎟️', name: '积分富翁', desc: '积分达 10', unlocked: me.points >= 10 },
    { ico: '🤝', name: '金牌搭档', desc: '完成 10 次交换', unlocked: me.exchanges >= 10 },
    { ico: '🏆', name: '传奇人物', desc: '信用分达 95', unlocked: me.credit >= 95 }
  ];
  document.getElementById('pf-achieve').innerHTML = achieves.map(a => `
    <div class="achieve ${a.unlocked ? 'unlocked' : ''}">
      <div class="a-ico">${a.ico}</div>
      <div class="a-name">${a.name}</div>
      <div class="a-desc">${a.desc}</div>
    </div>
  `).join('');

  const h = document.getElementById('pf-history');
  h.innerHTML = state.history.length
    ? state.history.map(x => `<div class="history-item">
        <div class="h-ico">${x.mode === 'barter' ? '🔄' : '🎟️'}</div>
        <div class="h-body">
          <div class="h-title">与 <b>${x.withName}</b> · ${x.skill}</div>
          <div class="h-sub">${new Date(x.time).toLocaleDateString('zh-CN')} · 信用分 +2</div>
        </div>
        <span class="h-mode ${x.mode}">${x.mode === 'barter' ? '技能互换' : '积分学习'}</span>
      </div>`).join('')
    : '<div class="card box empty">暂无交换记录，去发现页看看吧 🔍</div>';

  document.getElementById('pf-reviews').innerHTML = `
    <div class="review">
      <div class="r-head">
        <div class="r-user"><span class="mini-avatar">林</span>小林 <span class="stars">★★★★★</span></div>
        <span class="r-time">2 周前</span>
      </div>
      <div class="r-body">教吉他很有耐心，先带我认弦和按和弦，再一点点加快节奏。我第一次课就能弹出简单的伴奏型，课后还发了分解练习的视频。人也很守时，提前十分钟就进会议室了。</div>
      <div class="r-meta"><span class="r-tag pos"># 讲解细致</span><span class="r-tag pos"># 有课后练习</span><span class="r-tag pos"># 守时</span></div>
    </div>
    <div class="review">
      <div class="r-head">
        <div class="r-user"><span class="mini-avatar">鹏</span>大鹏 <span class="stars">★★★★☆</span></div>
        <span class="r-time">1 个月前</span>
      </div>
      <div class="r-body">换课过程很顺利，沟通清楚。吉他教学部分对我这种完全零基础的人很友好，会反复确认我有没有跟上。唯一小建议是希望能多讲一点乐理，方便以后自己看谱。</div>
      <div class="r-meta"><span class="r-tag pos"># 零基础友好</span><span class="r-tag sug"># 建议多讲乐理</span></div>
    </div>
  `;
}

/* ================= 详情页 ================= */
function openDetail(uid, mode) {
  const u = state.users.find(x => x.id === uid);
  if (!u) return;
  const me = state.me;
  const barter = isBarter(me, u);
  const canCredit = theyCanTeachMe(me, u);

  const body = document.getElementById('detail-body');
  body.innerHTML = `
    <div class="card box">
      <div class="user-row">
        <div class="avatar" style="width:58px;height:58px;font-size:1.25rem;border-radius:16px;">${u.avatar}</div>
        <div>
          <div class="name" style="font-size:1.12rem;">${u.name}
            ${u.hot ? '<span class="badge hot">🔥 热门</span>' : ''}
            <span class="badge verified">✔ 已认证</span>
            <span class="badge credit">⭐ 信用 ${u.credit}</span>
          </div>
          <div class="meta">已完成 ${u.exchanges || 0} 次交换 · ${u.reviews.length} 条评价</div>
        </div>
      </div>
      <div class="skill-pair">
        ${skillLine('teach', u.teach)}
        ${skillLine('learn', u.learn)}
      </div>
    </div>

    <h2 class="section"><span class="ico-box">📋</span>交换流程 <span class="hint">双方确认后开始</span></h2>
    <div class="card box">
      <div class="progress-track">
        <div class="p-step done"><div class="p-dot">✓</div>发起请求</div>
        <div class="p-step done"><div class="p-dot">✓</div>对方确认</div>
        <div class="p-step current"><div class="p-dot">3</div>协商时间</div>
        <div class="p-step"><div class="p-dot">4</div>完成交换</div>
        <div class="p-step"><div class="p-dot">5</div>互评结算</div>
      </div>
    </div>

    <h2 class="section"><span class="ico-box">🤝</span>选择交换方式</h2>
    <div class="mode-select" id="mode-select">
      ${barter ? `<div class="mode-opt ${mode === 'barter' ? 'selected' : ''}" data-mode="barter">
        <div class="m-ico">🔄</div>
        <div class="m-title">技能互换</div>
        <div class="m-desc">你教 TA「${me.teach.name}」<br>TA 教你「${u.teach.name}」</div>
      </div>` : ''}
      ${canCredit ? `<div class="mode-opt ${(!barter || mode === 'credit') ? 'selected' : ''}" data-mode="credit">
        <div class="m-ico">🎟️</div>
        <div class="m-title">积分学习</div>
        <div class="m-desc">消耗 1 积分<br>向 TA 学「${u.teach.name}」</div>
      </div>` : ''}
    </div>

    <h2 class="section"><span class="ico-box">💬</span>留言协商</h2>
    <div class="card box">
      <textarea id="msg" placeholder="想学什么内容、希望的时间安排、线上还是线下…"></textarea>
    </div>

    <div class="actions">
      <button class="btn btn-solid" onclick="sendRequest('${u.id}')">📨 发起交换请求</button>
      <button class="btn btn-danger" onclick="toast('已收到举报，我们会尽快核实处理')">⚠️ 举报该用户</button>
    </div>

    ${u.reviews.length ? `<h2 class="section"><span class="ico-box">💬</span>他人评价 <span class="hint">${u.reviews.length} 条来自真实交换对象</span></h2>
      <div class="card box">${u.reviews.map(reviewHTML).join('')}</div>` : ''}
  `;

  body.querySelectorAll('.mode-opt').forEach(el => {
    el.onclick = () => {
      body.querySelectorAll('.mode-opt').forEach(x => x.classList.remove('selected'));
      el.classList.add('selected');
    };
  });

  go('detail');
}

function sendRequest(uid) {
  const u = state.users.find(x => x.id === uid);
  if (!u) return;
  const sel = document.querySelector('#mode-select .mode-opt.selected');
  if (!sel) { toast('请先选择交换方式'); return; }
  const mode = sel.dataset.mode;

  if (mode === 'credit') {
    if (state.me.points < 1) { toast('积分不足，先教别人赚点积分吧'); return; }
    state.me.points -= 1;
  }
  state.me.exchanges += 1;
  state.me.credit = Math.min(100, state.me.credit + 2);
  if (mode === 'barter') state.me.points += 1;

  state.history.unshift({
    withName: u.name,
    skill: mode === 'barter' ? `${state.me.teach.name} ↔ ${u.teach.name}` : u.teach.name,
    mode,
    time: Date.now()
  });

  saveState();
  toast(mode === 'barter' ? '✅ 互换请求已发出，等待对方确认' : '🎟️ 已用 1 积分发起学习请求');
  setTimeout(() => go('profile'), 800);
}

/* ================= 发布页 ================= */
function bindChips(containerId) {
  const box = document.getElementById(containerId);
  if (!box) return;
  box.querySelectorAll('.chip').forEach(c => {
    c.onclick = () => {
      box.querySelectorAll('.chip').forEach(x => x.classList.remove('selected'));
      c.classList.add('selected');
    };
  });
}
function getChip(containerId) {
  const s = document.querySelector('#' + containerId + ' .chip.selected');
  return s ? s.dataset.v : '';
}

function saveSkills() {
  const tCat = document.getElementById('teach-cat').value;
  const tName = document.getElementById('teach-name').value.trim();
  const lCat = document.getElementById('learn-cat').value;
  const lName = document.getElementById('learn-name').value.trim();

  if (!tCat || !tName) { toast('请填写「我能教」的分类和技能名'); return; }
  if (!lCat || !lName) { toast('请填写「我想学」的分类和技能名'); return; }

  state.me.teach = { cat: tCat, name: tName, level: getChip('teach-level'), form: getChip('teach-form') };
  state.me.learn = { cat: lCat, name: lName, level: getChip('learn-level') };
  saveState();
  toast('✨ 技能档案已保存');
  fillPublishForm();
  renderDiscover();
  setTimeout(() => go('profile'), 700);
}

function fillPublishForm() {
  document.getElementById('teach-cat').value = state.me.teach.cat || '';
  document.getElementById('teach-name').value = state.me.teach.name || '';
  document.getElementById('learn-cat').value = state.me.learn.cat || '';
  document.getElementById('learn-name').value = state.me.learn.name || '';
  ['teach-level', 'teach-form', 'learn-level'].forEach(id => {
    const box = document.getElementById(id);
    const val = id === 'teach-level' ? state.me.teach.level
              : id === 'teach-form' ? state.me.teach.form
              : state.me.learn.level;
    box.querySelectorAll('.chip').forEach(c => {
      c.classList.toggle('selected', c.dataset.v === val);
    });
  });
}

/* ================= FAQ / 通知 / 滚动 ================= */
function toggleFaq(el) { el.parentElement.classList.toggle('open'); }
function openNotif() { document.getElementById('notif-modal').classList.add('show'); }
function closeNotif() { document.getElementById('notif-modal').classList.remove('show'); }
function scrollToList() {
  const el = document.getElementById('list-anchor');
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

/* ================= 路由 & 工具 ================= */
function go(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const el = document.getElementById('page-' + page);
  if (el) el.classList.add('active');
  document.querySelectorAll('.tab').forEach(t => {
    t.classList.toggle('active', t.dataset.page === page);
  });
  window.scrollTo({ top: 0, behavior: 'smooth' });

  if (page === 'discover') renderDiscover();
  if (page === 'profile') renderProfile();
  if (page === 'publish') fillPublishForm();
}

let toastTimer;
function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2400);
}

/* ================= 初始化 ================= */
bindChips('teach-level');
bindChips('teach-form');
bindChips('learn-level');
fillPublishForm();
initFilters();
renderDiscover();
renderProfile();
</script>
</body>
</html>
